{
  "manifest_version": 3,
  "name": "Tree Downloader",
  "version": "0.2.0",
  "description": "Send links, media and whole pages of links to Tree, the native Windows download manager.",
  "permissions": ["contextMenus", "storage", "downloads", "activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:17817/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Tree Downloader",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "commands": {
    "send-page": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Send the current page to Tree"
    },
    "pick-links": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "Pick links on this page for Tree"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
