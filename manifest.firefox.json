{
  "manifest_version": 2,
  "name": "Tree Downloader",
  "version": "0.1.0",
  "description": "Send links and downloads to Tree, the native Windows download manager.",
  "permissions": [
    "contextMenus",
    "storage",
    "downloads",
    "activeTab",
    "http://127.0.0.1:17817/*"
  ],
  "background": {
    "scripts": ["background-firefox.js"],
    "persistent": false
  },
  "browser_action": {
    "default_title": "Tree Downloader",
    "default_popup": "popup-firefox.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
